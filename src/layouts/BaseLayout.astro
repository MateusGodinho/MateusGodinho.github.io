---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
  hideNav?: boolean;
}

const {
  title,
  description = "Economist covering emerging markets macro and monetary policy.",
  wide = false,
  hideNav = false,
} = Astro.props;

const SITE_NAME = "Mateus Godinho";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title} · {SITE_NAME}</title>
  </head>
  <body>
    {!hideNav && (
      <div class={wide ? "wrap-wide" : "wrap"} style="padding-top: 32px;">
        <Nav />
      </div>
    )}
    <main class={wide ? "wrap-wide" : "wrap"}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

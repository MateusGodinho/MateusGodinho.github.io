---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allArticles = await getCollection("articles", ({ data }) => !data.draft || import.meta.env.DEV);
const featured = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 4);

const TAGLINE = "Economist covering emerging markets macro and monetary policy.";
const BIO = `Six years as an economist at Genoa Capital, covering monetary policy and
  macro across emerging markets -- South Africa, China, and Central & Eastern Europe,
  plus supplementary US coverage. This site is where I publish independent research,
  including code, on central bank communication and inflation dynamics.`;
---

<BaseLayout title="Home" description={TAGLINE}>
  <h1 class="visually-hidden">Mateus Godinho — {TAGLINE}</h1>

  <div class="home-grid">
    <aside>
      <div class="side-card profile-card">
        <div class="profile-head">
          <p class="name">Mateus Godinho</p>
          <p class="title">Economist</p>
        </div>

        <div class="profile-photo">
          <img src="/images/avatar.jpg" alt="Mateus Godinho" />
        </div>

        <div class="resume-summary">
          <p class="label">Previous position</p>
          <p>Economist, Genoa Capital (Jun 2020 – May 2026)</p>

          <p class="label">Education</p>
          <p>M.A. in Economics, FGV/EPGE (2018–2020)</p>

          <p class="label">Skills</p>
          <p>Econometrics, macroeconomic modeling, inflation forecasting, monetary
            policy analysis</p>
        </div>

        <a class="btn btn-primary" href="/cv.pdf" target="_blank">Download CV</a>
      </div>
    </aside>

    <section>
      <p class="eyebrow">About me</p>
      <p>{BIO} <a href="/cv">See full CV &rarr;</a></p>

      <p class="eyebrow" style="margin-top: 40px;">Latest research&hellip;</p>

      {featured.length === 0 && <p style="color: var(--muted);">No articles published yet.</p>}

      <div class="research-grid">
        {featured.map((post) => (
          <a class="research-card" href={`/articles/${post.id}/`}>
            {post.data.cover ? (
              <div class="thumb">
                <img src={post.data.cover} alt="" />
              </div>
            ) : (
              <div class="thumb placeholder">{post.data.title}</div>
            )}
            <p class="cap">{post.data.title}{post.data.draft && " (draft)"}</p>
          </a>
        ))}
      </div>

      <p style="margin-top: 8px;"><a href="/articles">See all research &rarr;</a></p>
    </section>
  </div>
</BaseLayout>

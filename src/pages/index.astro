---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import { getCollection } from "astro:content";
import { ARTIFACTS } from "../data/artifacts";

const allArticles = await getCollection("articles", ({ data }) => !data.draft || import.meta.env.DEV);
const featured = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 4);
const featuredArtifacts = ARTIFACTS.slice(0, 4);

const TAGLINE = "Economist covering emerging markets macro and monetary policy.";
const BIO = `Six years as an economist at Genoa Capital, covering monetary policy and
  macro across emerging markets -- South Africa, China, and Central & Eastern Europe,
  plus supplementary US coverage. This site is where I publish independent research,
  including code, on econometric models and macroeconomic analysis -- part of a
  deliberate effort to stay current by folding AI into the methodology itself, not
  just the writing.`;
---

<BaseLayout title="Home" description={TAGLINE} wide hideNav>
  <h1 class="visually-hidden">Mateus Godinho — {TAGLINE}</h1>

  <div class="home-grid">
    <aside>
      <div class="side-card profile-card">
        <div class="profile-head">
          <p class="name">Mateus Godinho</p>
          <p class="title">Economist</p>
        </div>

        <div class="profile-photo">
          <img src="/images/avatar.jpg" alt="Mateus Godinho" />
          <span class="photo-badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17 9 11 13 15 21 7" /><path d="M15 7h6v6" /></svg>
          </span>
        </div>

        <div class="resume-summary">
          <p class="label">Previous position</p>
          <p>Economist, Genoa Capital (Jun 2020 – May 2026)</p>

          <p class="label">Education</p>
          <p>M.A. in Economics, FGV/EPGE (2018–2020)</p>
          <p class="sub-link"><a href="https://repositorio.fgv.br/items/d3697bf0-eb8e-4733-8b48-c6df4680a689" target="_blank" rel="noopener">&rarr; Master's thesis</a></p>
          <p>B.A. in Economics, USP/FEA (2011–2015)</p>
          <p class="sub-link"><a href="https://revistas.usp.br/ecoa/pt_BR/article/view/142937/187822" target="_blank" rel="noopener">&rarr; Undergraduate thesis (published as journal article)</a></p>

          <p class="label">Skills</p>
          <p>Econometrics, macroeconomic modeling, inflation forecasting, monetary
            policy analysis</p>
        </div>

        <a class="btn btn-primary" href="/cv.pdf" target="_blank">
          Download CV
          <span class="icon-circle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12" /><path d="m7 11 5 5 5-5" /><path d="M5 21h14" /></svg>
          </span>
        </a>
      </div>
    </aside>

    <div class="home-main">
      <Nav />

      <section class="card">
        <p class="eyebrow">About me</p>
        <p>{BIO} <a href="/cv">See full CV &rarr;</a></p>
      </section>

      <section class="card">
        <p class="eyebrow">Latest research&hellip;</p>

        {featured.length === 0 && <p style="color: var(--muted);">No articles published yet.</p>}

        <div class="research-list">
          {featured.map((post) => (
            <a class="research-row" href={`/articles/${post.id}/`}>
              <h3>{post.data.title}{post.data.draft && " (draft)"}</h3>
              <div class="row-tags">
                {post.data.tags.map((t: string) => <span class="tag">{t}</span>)}
              </div>
              <p class="row-excerpt">{post.data.description}</p>
              <p class="row-date">
                {post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
              </p>
            </a>
          ))}
        </div>

        <p style="margin-top: 16px;"><a href="/articles">See all research &rarr;</a></p>
      </section>

      <section class="card">
        <p class="eyebrow">Research tools</p>
        <p class="section-intro">Small interactive tools I build alongside the research --
          demos that run the actual method live, no install required. Adding to this as I
          go.</p>

        <div class="artifact-list">
          {featuredArtifacts.map((a) => (
            <div class="artifact-row">
              <h3>{a.title}</h3>
              <p class="row-excerpt">{a.description}</p>
              <p class="artifact-links">
                <a href={a.url} target="_blank" rel="noopener">Open the tool &rarr;</a>
                <span class="related">Built for <a href={a.relatedHref}>{a.relatedLabel}</a></span>
              </p>
            </div>
          ))}
        </div>

        <p style="margin-top: 16px;"><a href="/artifacts">See all research tools &rarr;</a></p>
      </section>
    </div>
  </div>
</BaseLayout>

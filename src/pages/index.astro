---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allArticles = await getCollection("articles", ({ data }) => !data.draft || import.meta.env.DEV);
const featured = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 4);

const TAGLINE = "Economist covering emerging markets macro and monetary policy.";
const BIO_SHORT = `Six years covering EM monetary policy at Genoa Capital. This is where
  I publish independent research -- with code -- on central bank communication and
  inflation dynamics.`;

const GITHUB = "https://github.com/MateusGodinho";
const LINKEDIN = "https://www.linkedin.com/in/mateus-machado-godinho";
const EMAIL = "mailto:mateus.godinho0704@gmail.com";
---

<BaseLayout title="Home" description={TAGLINE}>
  <h1 class="visually-hidden">Mateus Godinho — {TAGLINE}</h1>
  <p class="home-tagline">{TAGLINE}</p>

  <div class="home-grid">
    <section>
      <p class="eyebrow">Latest research&hellip;</p>

      {featured.length === 0 && <p style="color: var(--muted);">No articles published yet.</p>}

      <div class="research-grid">
        {featured.map((post) => (
          <a class="research-card" href={`/articles/${post.id}/`}>
            {post.data.cover ? (
              <div class="thumb">
                <img src={post.data.cover} alt="" />
              </div>
            ) : (
              <div class="thumb placeholder">{post.data.title}</div>
            )}
            <p class="cap">{post.data.title}{post.data.draft && " (draft)"}</p>
          </a>
        ))}
      </div>

      <p style="margin-top: 8px;"><a href="/articles">See all research &rarr;</a></p>
    </section>

    <aside>
      <div class="side-card">
        <p class="eyebrow" style="margin-bottom: 16px;">About</p>
        <div class="who">
          <div class="avatar"><img src="/images/avatar.jpg" alt="Mateus Godinho" /></div>
          <p>I'm Mateus -- an economist writing about central bank communication and
            monetary policy, backed by code you can run yourself.</p>
        </div>
        <p class="bio">{BIO_SHORT} <a href="/cv">See full CV &rarr;</a></p>
        <div class="social-row">
          <a href={EMAIL} aria-label="Email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 6-10 7L2 6" /></svg>
          </a>
          <a href={GITHUB} target="_blank" rel="noopener" aria-label="GitHub">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1.15-.02-2.09-3.2.7-3.88-1.36-3.88-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.4-5.25 5.68.41.36.78 1.08.78 2.17 0 1.57-.01 2.83-.01 3.22 0 .3.2.66.79.55A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" /></svg>
          </a>
          <a href={LINKEDIN} target="_blank" rel="noopener" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z" /></svg>
          </a>
        </div>
      </div>

      <div class="cta-box">
        <span class="eyebrow">New research, when it drops</span>
        <p>No newsletter yet -- for now, following on LinkedIn is the fastest way to hear
          about new pieces.</p>
        <a class="btn btn-primary" href={LINKEDIN} target="_blank" rel="noopener">Follow on LinkedIn</a>
      </div>
    </aside>
  </div>
</BaseLayout>

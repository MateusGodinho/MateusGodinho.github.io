---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allArticles = await getCollection("articles", ({ data }) => !data.draft || import.meta.env.DEV);
const sorted = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Research" description="Independent research notes.">
  <p class="eyebrow">Research</p>
  <h1>All research notes</h1>

  {sorted.length === 0 && <p style="color: var(--muted);">No articles published yet.</p>}

  <div class="research-grid" style="grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));">
    {sorted.map((post) => (
      <a class="research-card" href={`/articles/${post.id}/`}>
        {post.data.cover ? (
          <div class="thumb">
            <img src={post.data.cover} alt="" />
          </div>
        ) : (
          <div class="thumb placeholder">{post.data.title}</div>
        )}
        <p class="cap">{post.data.title}{post.data.draft && " (draft)"}</p>
        <p class="meta" style="text-align: center;">
          {post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
        </p>
      </a>
    ))}
  </div>
</BaseLayout>

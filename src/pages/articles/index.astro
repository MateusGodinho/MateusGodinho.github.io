---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allArticles = await getCollection("articles", ({ data }) => !data.draft || import.meta.env.DEV);
const sorted = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Research" description="Independent research notes.">
  <p class="eyebrow">Research</p>
  <h1>All research notes</h1>

  {sorted.length === 0 && <p style="color: var(--muted);">No articles published yet.</p>}

  <div class="research-list">
    {sorted.map((post) => (
      <a class="research-row" href={`/articles/${post.id}/`}>
        <h3>{post.data.title}{post.data.draft && " (draft)"}</h3>
        <div class="row-tags">
          {post.data.tags.map((t: string) => <span class="tag">{t}</span>)}
        </div>
        <p class="row-excerpt">{post.data.description}</p>
        <p class="row-date">
          {post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
        </p>
      </a>
    ))}
  </div>
</BaseLayout>
